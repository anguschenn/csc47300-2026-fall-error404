# ==========================================
# Environment Variables & Secrets
# ==========================================
# Ignore all environment files containing secrets/API keys
.env
.env.*
.env.local
.env.*.local
*.env

# Whitelist example/template env files so teammates know what variables to configure
!.env.example
!.env.*.example

# ==========================================
# Frontend (React / Vite / Node)
# ==========================================
node_modules/
dist/
dist-ssr/
build/
*.local

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ==========================================
# Backend (Python / FastAPI)
# ==========================================
# Bytecode & Caches (matches at any folder depth)
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual Environments (backend/venv, root venv, .venv, etc.)
venv/
.venv/
env/
ENV/

# Testing & Type Checking / Linting
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# ==========================================
# Operating System & Editors
# ==========================================
# macOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
desktop.ini

# IDEs & Editors
.vscode/
.idea/
*.swp
*.swo
*~


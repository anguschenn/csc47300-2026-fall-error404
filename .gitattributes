# ==========================================
# Git Line Ending Normalization
# ==========================================

# Auto-detect text files and normalize line endings to LF on commit
* text=auto eol=lf

# Explicitly declare text files to always use LF
*.py text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.json text eol=lf
*.css text eol=lf
*.html text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.env* text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf

# Windows command / script files - preserve CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary assets - prevent Git from attempting line-ending conversion
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg text eol=lf
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary

